# Builds from this checkout. The version counts the commits that touched apps/linux, so it only
# goes up when the app changes; publish.sh raises pkgrel when a rebuild links new libraries.
_app=$(cd "$startdir/.." && pwd)
pkgname=hatbot
pkgver=$(sed -n 's/^version = "\(.*\)"/\1/p' "$_app/Cargo.toml" | head -n1).r$(git -C "$_app" rev-list --count HEAD -- .).g$(git -C "$_app" log -1 --format=%h --abbrev=7 -- .)
pkgrel=${HATBOT_PKGREL:-1}
pkgdesc='A GTK app for Hatbot, your self-hosted agent'
arch=(x86_64 aarch64)
url='https://git.gaycats.ovh/kubus/hatbot'
license=(MIT)
depends=(gcc-libs glib2 glibc gtk4 libadwaita libsecret libsoup3 webkitgtk-6.0)
makedepends=(cargo git)
optdepends=('org.freedesktop.secrets: keeps you signed in (GNOME Keyring, KWallet or KeePassXC)')
options=(!debug)

build() {
  cd "$_app"
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --locked
}

package() {
  cd "$_app"
  install -Dm755 "$srcdir/target/release/hatbot" -t "$pkgdir/usr/bin"
  install -Dm644 data/ovh.gaycats.Hatbot.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 data/icons/ovh.gaycats.Hatbot.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 ../../LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
