# Hatbot's Linux app: the tray app and the agent that lets Hatbot use this computer.
# Builds from this checkout. The version counts the commits that touched apps/linux, so it only
# goes up when the app changes; publish.sh raises pkgrel when a rebuild links new libraries.
_app=$(cd "$startdir/.." && pwd)
pkgname=hatbot
pkgver=$(sed -n 's/^version = "\(.*\)"/\1/p' "$_app/Cargo.toml" | head -n1).r$(git -C "$_app" rev-list --count HEAD -- .).g$(git -C "$_app" log -1 --format=%h --abbrev=7 -- .)
pkgrel=${HATBOT_PKGREL:-1}
pkgdesc="Hatbot on your Linux computer"
arch=('x86_64' 'aarch64')
url="https://git.gaycats.ovh/kubus/hatbot"
license=('MIT')
depends=('libxkbcommon' 'wayland' 'dbus' 'gcc-libs' 'glibc')
optdepends=('vulkan-icd-loader: draws the window on the GPU'
  'at-spi2-core: lets Hatbot read what is on screen in apps that support it')
makedepends=('cargo' 'git')
install=hatbot.install
options=(!debug !lto)

build() {
  cd "$_app"
  CARGO_TARGET_DIR="$srcdir/target" cargo build --locked --release -p hatbot
}

check() {
  cd "$_app"
  CARGO_TARGET_DIR="$srcdir/target" cargo test --locked -p hatbot-agent
}

package() {
  cd "$_app"
  install -Dm755 "$srcdir/target/release/hatbot" "$pkgdir/usr/bin/hatbot"
  install -Dm644 packaging/ovh.gaycats.Hatbot.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/ovh.gaycats.Hatbot.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/hatbot.service "$pkgdir/usr/lib/systemd/user/hatbot.service"
  install -Dm644 packaging/70-hatbot-uinput.rules "$pkgdir/usr/lib/udev/rules.d/70-hatbot-uinput.rules"
  install -Dm644 packaging/hatbot-uinput.conf "$pkgdir/usr/lib/modules-load.d/hatbot-uinput.conf"
  install -Dm644 ../../LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
