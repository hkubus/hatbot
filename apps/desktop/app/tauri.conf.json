{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hatbot",
  "identifier": "ovh.gaycats.Hatbot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
